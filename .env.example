# Which AI runs SuperAgent:
#   claude-code = Claude, through the Claude Code CLI and the subscription logged in on this
#                 computer (install Claude Code, run `claude` once and log in). Default.
#   ollama      = a local model run by Ollama (e.g. qwen3.5:9b).
LLM_BACKEND=claude-code

# Models. On Claude use an alias (sonnet, haiku, opus) or a full model name; on Ollama a pulled
# model such as qwen3.5:9b. Leave them out to use the defaults (Claude: haiku for the router,
# sonnet for everything else; Ollama: qwen3.5:9b). Ollama names are ignored on Claude.
# The agent: decides which tools to use for multi-step goals.
PLANNER_MODEL=sonnet
# Reads every message to decide what is wanted; a fast model keeps replies quick.
ROUTER_MODEL=haiku
# Draws house plans.
DESIGN_MODEL=sonnet
# Estimates materials, costs and timelines.
ESTIMATE_MODEL=sonnet

# Let the planner think before each decision (more accurate answers). Set to false for speed.
PLANNER_THINK=true

# Let the model reason before drawing. Much better plans, but slower. Set to false for speed.
DESIGN_THINK=true

# Slack bot (npm run dev). Tokens come from your Slack app's settings.
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# Where the Slack bot replies and what it remembers:
#   channel = replies in the channel, one shared memory per channel (default)
#   user    = replies in the channel, a separate memory for each person
#   thread  = replies in a thread, a separate memory for each thread
SLACK_REPLY_MODE=channel

# Proactive daily project digest: the agent posts a briefing in this channel every day.
# Leave DIGEST_CHANNEL empty to turn it off. DIGEST_TIME is HH:MM in this computer's time zone.
DIGEST_CHANNEL=
DIGEST_TIME=08:30
