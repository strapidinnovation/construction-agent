# Model that draws house plans. Any model pulled in Ollama works, e.g. qwen3.5:27b
DESIGN_MODEL=qwen3.5:9b

# Model that estimates materials and costs.
ESTIMATE_MODEL=qwen3.5:9b

# Let the model reason before drawing. Much better plans, but ~2-3x slower. Set to false for speed.
DESIGN_THINK=true

# Slack bot (npm run dev). Tokens come from your Slack app's settings.
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# Where the Slack bot replies and what it remembers:
#   channel = replies in the channel, one shared memory per channel (default)
#   user    = replies in the channel, a separate memory for each person
#   thread  = replies in a thread, a separate memory for each thread
SLACK_REPLY_MODE=channel
